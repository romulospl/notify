{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommitTypeAll(chore)"
  ],
  "description": "Updates by PR, only with releases at least 14 days old (ADR 0002).",
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)infra/compose/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "A major version only opens a PR after being approved in the Dependency Dashboard (security updates go straight through).",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Umami is only upgraded by a reviewed PR, never grouped or automatic.",
      "matchDepNames": [
        "ghcr.io/umami-software/umami"
      ],
      "groupName": null,
      "automerge": false,
      "labels": [
        "dependencies",
        "umami"
      ]
    },
    {
      "description": "Postgres: only minor and patch within the same major version.",
      "matchDepNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "GitHub Actions grouped in one PR.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    }
  ]
}
