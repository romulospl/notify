# Copy to .env to change the default values of the local environment (docker compose).
# The defaults below are for development only.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
UMAMI_DB_PASSWORD=umami
STELLYTICS_DB_PASSWORD=stellytics
STELLYTICS_INGEST_DB_PASSWORD=stellytics_ingest
STELLYTICS_COLLECTOR_DB_PASSWORD=stellytics_collector
# Umami port on the host, used only by the development override
# infra/compose/umami-port.yaml (Umami publishes no port by default, #62).
# To always include it on your machine: COMPOSE_FILE=compose.yaml:infra/compose/umami-port.yaml
# (never in a production .env).
UMAMI_PORT=3001
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
UMAMI_APP_SECRET=dev-only-umami-app-secret
PORTAL_PORT=3000
# Sign-up with prior approval (#49): true leaves new projects pending until an
# operator approves them in /operator/approvals. Off by default.
SIGNUP_APPROVAL=false
# Public demo: slug of the project shown without sign-in at /demo and
# /operator. Empty: the demo shows sample data.
DEMO_TENANT_SLUG=
PORTAL_AUTH_SECRET=dev-only-portal-auth-secret-change-me
# API key of the portal's service account in Umami. Generate it with:
#   UMAMI_ADMIN_PASSWORD=umami pnpm --filter @stellytics/portal umami:service-account
UMAMI_API_KEY=
INGEST_WEB_PORT=3002
# Header in which the gateway hands Umami the already truncated IP.
CLIENT_IP_HEADER=x-stellytics-client-ip
# Comma-separated CIDRs from which X-Forwarded-For is accepted (empty: none).
INGEST_TRUSTED_PROXIES=
# Events per second and burst per truncated IP.
INGEST_RATE_LIMIT=20
INGEST_RATE_BURST=40
INGEST_SITE_CACHE_TTL=5s
# JS execution proof (#25): challenge key (32+ characters) and difficulty in bits.
INGEST_PROOF_SECRET=dev-only-ingest-proof-secret-change-me
INGEST_PROOF_BITS=12
# Limit of distinct fingerprints per truncated IP and site in the window (#26); 0 turns it off.
INGEST_FINGERPRINT_LIMIT=50
INGEST_FINGERPRINT_WINDOW=10m
# API metrics collector (#30): OTLP ports on the host and ingest key cache.
COLLECTOR_GRPC_PORT=4317
COLLECTOR_HTTP_PORT=4318
COLLECTOR_KEY_CACHE_TTL=5s
