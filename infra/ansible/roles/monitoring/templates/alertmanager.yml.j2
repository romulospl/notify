# Gerado pelo Ansible (infra/ansible/roles/monitoring). Não edite na VM.
# Alertas por e-mail; o Watchdog vai para o sinal de vida externo, se houver.
global:
  smtp_smarthost: "{{ monitor_smtp_smarthost }}"
  smtp_from: "{{ monitor_smtp_from }}"
{% if monitor_smtp_username | default('') %}
  smtp_auth_username: "{{ monitor_smtp_username }}"
  smtp_auth_password_file: /etc/alertmanager/secrets/smtp_password
{% endif %}
  smtp_require_tls: {{ monitor_smtp_require_tls | default(true) | string | lower }}

route:
  receiver: email
  group_by: [alertname, component]
  group_wait: 30s
  group_interval: 1m
  repeat_interval: 4h
  routes:
    - matchers: ['alertname="Watchdog"']
      receiver: {{ 'deadman' if monitor_deadman_url | default('') else 'blackhole' }}
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 5m

receivers:
  - name: email
    email_configs:
      - to: "{{ monitor_alert_email }}"
        send_resolved: true
  - name: blackhole
{% if monitor_deadman_url | default('') %}
  - name: deadman
    webhook_configs:
      - url_file: /etc/alertmanager/secrets/deadman_url
        send_resolved: false
{% endif %}

inhibit_rules:
  # Sem o blackbox, os EndpointDown e ProbeFailing não dizem nada novo.
  - source_matchers: ['alertname="ProberDown"']
    target_matchers: ['alertname=~"EndpointDown|ProbeFailing"']
