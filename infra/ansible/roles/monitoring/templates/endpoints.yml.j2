# Gerado pelo Ansible (infra/ansible/roles/monitoring). Alvos do blackbox.
- targets: ["https://{{ portal_host }}/api/auth/ok"]
  labels:
    component: portal
- targets: ["https://{{ ingest_host }}/healthz"]
  labels:
    component: ingest-web
{% if monitor_api_url | default('') %}
- targets: ["{{ monitor_api_url }}"]
  labels:
    component: ingest-api
{% endif %}
