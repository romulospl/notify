# Production Caddy (ADR 0014, ADR 0016): the only entry point, with automatic TLS.
#
# Rules checked in the #14 review (infra/README.md):
# - no route leads to Umami, neither the UI nor the API (#62);
# - the gateway publishes only /e, /c, /s/ and /healthz; the rest answers 404,
#   except /healthz/stack, which Caddy itself answers (stack check);
# - the collector publishes only OTLP (HTTP at /v1/traces, /v1/metrics and
#   /v1/logs, and gRPC), always with an ingest key; the rest answers 404 (ADR 0012).
#
# The ingestion host name must not contain terms that ad blockers block
# (`umami`, `analytics`, `track`, `collect`; see CLAUDE.md).

{
	email {$ACME_EMAIL}
	# No log keeps the client IP, the headers or the URL with its query: not even
	# the error logs (for example, 502 when the gateway restarts), which Caddy
	# writes even without an access log. The full IP is never persisted (CLAUDE.md).
	log default {
		output stderr
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>uri delete
			request>tls delete
		}
	}
	# No trusted_proxies: Caddy drops the incoming X-Forwarded-For and sends
	# the real connection IP. The gateway trusts only Caddy's X-Forwarded-For
	# (TRUSTED_PROXIES in compose/prod.yaml). For the real IP to reach Caddy, the
	# VPS Docker runs with userland-proxy off (init.sh, configure-docker.py).
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No "Server: Caddy" header.
		-Server
	}
}

{$PORTAL_HOST} {
	import security_headers
	header X-Frame-Options "DENY"
	encode zstd gzip
	reverse_proxy portal:3000
}

{$PORTAL_ALIAS_HOST} {
	import security_headers
	redir https://{$PORTAL_HOST}{uri} permanent
}

{$INGEST_HOST} {
	import security_headers
	# Stack status on the VPS for the external monitoring: 200 while
	# stellytics-check (infra/scripts/stack-check.py) keeps the stack-ok
	# file, 503 without it. Only the code; the reasons stay in the VPS journal.
	handle /healthz/stack {
		header Cache-Control "no-store"
		@stackok file {
			root /srv/status
			try_files /stack-ok
		}
		handle @stackok {
			respond "ok" 200
		}
		handle {
			respond "unavailable" 503
		}
	}
	@gateway path /e /c /s/* /healthz
	handle @gateway {
		encode zstd gzip
		reverse_proxy ingest-web:8080
	}
	handle {
		respond 404
	}
}

# API ingestion (ADR 0012): OTLP/HTTP and OTLP/gRPC on the same host, on 443. The
# ingest key goes in the Authorization header, which the log above does not keep.
{$API_HOST} {
	import security_headers
	@grpc {
		method POST
		header Content-Type application/grpc*
		path /opentelemetry.proto.collector.*
	}
	handle @grpc {
		reverse_proxy h2c://collector:4317
	}
	@otlp {
		method POST
		path /v1/traces /v1/metrics /v1/logs
	}
	handle @otlp {
		reverse_proxy collector:4318
	}
	handle {
		respond 404
	}
}
