# Caddy de produção (ADR 0014, ADR 0016): única porta de entrada, com TLS automático.
#
# Regras conferidas na revisão da #14 (infra/README.md):
# - nenhuma rota leva ao Umami, nem à interface nem à API (#62);
# - o gateway publica só /e, /c, /s/ e /healthz; o resto responde 404;
# - o coletor publica só o OTLP (HTTP em /v1/traces, /v1/metrics e /v1/logs, e
#   gRPC), sempre com chave de ingestão; o resto responde 404 (ADR 0012).
#
# O nome do host da ingestão não pode ter termos que ad blockers bloqueiam
# (`umami`, `analytics`, `track`, `collect`; ver CLAUDE.md).

{
	email {$ACME_EMAIL}
	# Nenhum log guarda o IP do cliente, os cabeçalhos ou a URL com query: nem
	# os de erro (por exemplo, 502 quando o gateway reinicia), que o Caddy
	# grava mesmo sem access log. O IP completo nunca é persistido (CLAUDE.md).
	log default {
		output stderr
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>uri delete
			request>tls delete
		}
	}
	# Sem trusted_proxies: o Caddy descarta o X-Forwarded-For que chega e manda
	# o IP real da conexão. O gateway só confia no X-Forwarded-For do Caddy
	# (TRUSTED_PROXIES em compose/prod.yaml). Para o IP real chegar ao Caddy, o
	# Docker da VPS roda com userland-proxy desligado (init.sh, configure-docker.py).
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Sem o cabeçalho "Server: Caddy".
		-Server
	}
}

{$PORTAL_HOST} {
	import security_headers
	header X-Frame-Options "DENY"
	encode zstd gzip
	reverse_proxy portal:3000
}

{$PORTAL_ALIAS_HOST} {
	import security_headers
	redir https://{$PORTAL_HOST}{uri} permanent
}

{$INGEST_HOST} {
	import security_headers
	@gateway path /e /c /s/* /healthz
	handle @gateway {
		encode zstd gzip
		reverse_proxy ingest-web:8080
	}
	handle {
		respond 404
	}
}

# Ingestão de API (ADR 0012): OTLP/HTTP e OTLP/gRPC no mesmo host, na 443. A
# chave de ingestão vai no cabeçalho Authorization, que o log acima não guarda.
{$API_HOST} {
	import security_headers
	@grpc {
		method POST
		header Content-Type application/grpc*
		path /opentelemetry.proto.collector.*
	}
	handle @grpc {
		reverse_proxy h2c://collector:4317
	}
	@otlp {
		method POST
		path /v1/traces /v1/metrics /v1/logs
	}
	handle @otlp {
		reverse_proxy collector:4318
	}
	handle {
		respond 404
	}
}
