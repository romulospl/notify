{
  "name": "@stellytics/portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:operator": "node scripts/build-operator.mjs",
