# init.sh generates random values for every empty password/secret field.
# Fill in the domains, ACME email and backup bucket before running deploy.sh.
POSTGRES_PASSWORD=
UMAMI_DB_PASSWORD=
STELLYTICS_DB_PASSWORD=
STELLYTICS_INGEST_DB_PASSWORD=
STELLYTICS_COLLECTOR_DB_PASSWORD=
UMAMI_APP_SECRET=
PORTAL_AUTH_SECRET=
INGEST_PROOF_SECRET=

# Domains with DNS A/AAAA records pointing to the VPS.
PORTAL_HOST=
PORTAL_ALIAS_HOST=
INGEST_HOST=
API_HOST=
ACME_EMAIL=
POSTGRES_ADMIN_PORT=5432

# Continuous Postgres backup (WAL-G) to S3-compatible storage, encrypted on
# the VPS with WALG_LIBSODIUM_KEY (generated by init.sh; keep a copy outside
# the VPS). E.g.: WALG_S3_PREFIX=s3://bucket/stellytics
WALG_S3_PREFIX=
WALG_S3_ENDPOINT=
WALG_S3_REGION=
WALG_S3_ACCESS_KEY=
WALG_S3_SECRET_KEY=
WALG_LIBSODIUM_KEY=
WALG_RETAIN_FULL=7
STELLYTICS_DATA_DIR=/srv/stellytics

# Optional: the public portal sends no email in this version (no sign-up,
# operator invites disabled).
SMTP_URL=
MAIL_FROM=

# Empty on the first deploy. Set the Umami service account key afterwards;
# required when DEMO_TENANT_SLUG is set.
UMAMI_API_KEY=
SIGNUP_APPROVAL=false
# Public demo: slug of the one project shown without sign-in at /demo
# and /operator. Empty: the demo shows sample data.
DEMO_TENANT_SLUG=
INGEST_RATE_LIMIT=20
INGEST_RATE_BURST=40
INGEST_FINGERPRINT_LIMIT=50
INGEST_SITE_STALE_TTL=0
INGEST_RELAY_MAX_INFLIGHT=0
INGEST_RELAY_QUEUE_WAIT=250ms
COLLECTOR_KEY_CACHE_TTL=60s
COLLECTOR_MEM_LIMIT=512m
ROLLUP_INTERVAL=15m
ROLLUP_LOOKBACK=48h
UMAMI_RETENTION_DAYS=183

# Optional: signed release images by digest (ghcr.io/<owner>/stellytics/<name>@sha256:...),
# all four or none. Empty: deploy.sh builds them from this checkout. Run
# `cosign verify` on each digest first (docs/deploy.md).
PORTAL_IMAGE=
INGEST_WEB_IMAGE=
COLLECTOR_IMAGE=
ROLLUP_IMAGE=
